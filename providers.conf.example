# Кастомные провайдеры.
#
# Скопируйте этот файл в providers.conf рядом с .env (на Render — добавьте
# как Secret File с именем providers.conf). Путь можно переопределить
# переменной окружения PROVIDERS_FILE.
#
# Имя секции — идентификатор провайдера. Оно же:
#   * локальный эндпоинт   -> /proxy/<id>/v1/chat/completions
#   * имя семейства моделей -> лимиты токенов, ALLOWED_MODEL_FAMILIES, статистика
# Менять его после запуска не стоит: накопленные счётчики и лимиты
# пользователей останутся под старым именем.
#
# Допустимы строчные латинские буквы, цифры, "-" и "_", до 32 символов.
# Идентификатор не должен совпадать со встроенным провайдером или семейством
# (openai, deepseek, glm, moonshot, atf, gpt4o, ...).

[example]
# --- обязательные параметры ---

# Формат API апстрима: openai, anthropic или google-ai.
# От него зависят эндпоинты, которые появятся у /proxy/<id>, и способ
# авторизации на апстриме:
#
#   openai     POST /v1/chat/completions
#              ключ уходит как Authorization: Bearer
#
#   anthropic  POST /v1/messages            (родной формат)
#              POST /v1/chat/completions    (запрос в формате OpenAI,
#                                            переводится в Anthropic)
#              ключ уходит как X-API-Key + anthropic-version
#
#   google-ai  POST /v1beta/models/<модель>:generateContent
#              POST /v1beta/models/<модель>:streamGenerateContent
#              POST /v1/chat/completions    (запрос в формате OpenAI,
#                                            переводится в Gemini)
#              ключ уходит в URL как ?key=
#
# GET /v1/models есть у всех типов; у google-ai дополнительно
# GET /v1beta/models в родном формате Gemini.
#
# Кросс-тип "<клиентский> to <апстримовый>" — прокси принимает запросы в
# одном формате, а на апстрим отправляет в другом; ответ переводится
# обратно, в том числе в потоке. Апстримовым пока может быть только
# openai, потому что именно так устроено подавляющее большинство чужих
# апстримов:
#
#   type = google-ai to openai   клиент ходит на
#                                POST /v1beta/models/<модель>:generateContent
#                                и :streamGenerateContent, апстриму уходит
#                                POST /v1/chat/completions
#
#   type = anthropic to openai   клиент ходит на POST /v1/messages,
#                                апстриму уходит POST /v1/chat/completions
#
# У кросс-типа открыты только эндпоинты клиентского формата: например,
# у "anthropic to openai" нет /v1/chat/completions — для OpenAI-клиентов
# заведите отдельную секцию с type = openai и тем же адресом.
type = openai

# Базовый адрес апстрима, только https. Слеш на конце можно не убирать.
url = https://example.trycloudflare.com/proxy

# Ключи. "$ИМЯ" — ссылка на переменную окружения (рекомендуется: сам файл
# тогда несекретный). Можно и списком через запятую: keys = tok1, tok2
keys = $EXAMPLE_KEY

# --- необязательные параметры ---

# Отправлять запросы к этому апстриму через прокси. Поддерживаются
# socks5, socks5h, socks4, socks4a, http, https; порт обязателен.
# Пароль с "@", ":" или другими спецсимволами нужно закодировать
# процентами: p@ss -> p%40ss.
#
# Через прокси идёт всё общение с апстримом: сами запросы, список
# моделей и проверка ключей. Как и keys, значение можно вынести в
# переменную окружения: proxy = $EXAMPLE_PROXY
#
# socks5h отправляет DNS-запрос через прокси, socks5 резолвит имя локально.
proxy = socks5://user:password@127.0.0.1:1080

# Какие модели показывать. Если параметр не задан, отдаётся весь список
# апстрима как есть.
#
# "реальная-модель as псевдоним" показывает модель под другим именем:
# клиент видит и запрашивает псевдоним, апстриму уходит реальное имя,
# в ответе (в том числе в потоке) имя подменяется обратно на псевдоним.
# Реальное имя при этом перестаёт приниматься и исчезает из выдачи —
# иначе маскировка обходилась бы прямым запросом по настоящему имени.
#
# "*" означает "и всё остальное, что отдаёт апстрим". Без неё список
# закрытый: всё, чего в нём нет, скрыто и отклоняется.
#
#   models = deepseek-chat as gpt-4o, *     одна модель под маской,
#                                           остальные как есть
#   models = deepseek-chat as gpt-4o        видна только gpt-4o
#
# Длинный список можно перенести на несколько строк с отступом.
models =
  deepseek-chat as gpt-4o,
  deepseek-reasoner as o1,
  glm-4.6

# Как собирается путь к апстриму:
#   v1   -> <url>/v1/chat/completions   (по умолчанию)
#   bare -> <url>/chat/completions
# Если апстрим отвечает 404 — переключите на bare.
# Для типа google-ai не используется: там версия API (v1beta/v1alpha)
# и имя модели входят в путь по правилам самого Gemini.
path-style = v1

# Максимальный размер контекста. Понимает 128k, 1m и обычные числа.
# По умолчанию 200k, так как имена моделей у чужого апстрима произвольные.
context = 128k

# Стоимость в долларах за 1M токенов: вход / выход. По умолчанию 0 / 0,
# то есть расход считается в токенах, но не в деньгах.
price = 0.55 / 2.19

# Deepseek-style префилл (prefix: true) для моделей, в имени которых есть
# "deepseek". По умолчанию no: чужой апстрим может не принимать этот параметр.
prefill = no

# Проверять ли ключи при старте. По умолчанию — как глобальный CHECK_KEYS.
# Проверка делает GET <url>/v1/models и не тратит квоту апстрима.
check-keys = yes

# Что делать, если апстрим отвечает 429 (слишком много запросов) уже после
# того, как начал отдавать поток. Такое бывает, когда апстрим — тоже прокси:
# она отвечает 200, открывает SSE и только потом присылает внутрь потока
# ошибку вроде {"error":{"code":429,...}}. По HTTP-коду это не отличить от
# успешного ответа, поэтому без этого параметра ошибка уходит клиенту как
# есть (в SillyTavern — красный тост), и запрос не повторяется.
#
#   no    (по умолчанию) отдать ошибку клиенту
#   yes   повторять запрос с той же паузой, что и в непотоковых запросах
#   <N>   повторять запрос с паузой N секунд между попытками
#
# Ограничения по числу попыток нет — они идут, пока запрос не выполнится или
# пока очередь не убьёт его через 5 минут, ровно как в непотоковых запросах.
# Поэтому пауза больше 120 секунд не принимается. Пока запрос ждёт, он
# остаётся в очереди и клиент продолжает получать heartbeat, так что
# соединение не рвётся.
#
# Повтор делается только до того, как клиенту ушёл хоть кусок ответа: если
# апстрим оборвался посреди уже начатого текста, повторный ответ дописался бы
# к недописанному. Обычные 429 (те, что приходят настоящим HTTP-статусом)
# повторяются всегда, независимо от этого параметра.
retry-429 = 10

# Подпись на инфо-странице. По умолчанию — идентификатор заглавными.
label = Example

# Ещё один провайдер — просто новая секция.
#
# [claudeproxy]
# type   = anthropic
# url    = https://another.example.com/proxy/anthropic
# keys   = $CLAUDE_PROXY_KEY
# models = claude-sonnet-4-5 as claude-3-5-sonnet-20241022, *
#
# [gemproxy]
# type   = google-ai
# url    = https://another.example.com/proxy/google-ai
# keys   = $GEM_PROXY_KEY
